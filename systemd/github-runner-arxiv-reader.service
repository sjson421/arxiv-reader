[Unit]
Description=GitHub Actions runner for sjson421/arxiv-reader
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h/actions-runner-arxiv-reader
ExecStart=%h/actions-runner-arxiv-reader/run.sh
Restart=always
RestartSec=10
KillMode=process

[Install]
WantedBy=default.target
